# Required
ANTHROPIC_API_KEY=sk-ant-...

# Models (override per role if useful)
GRAPH_AGENT_MODEL=claude-sonnet-5
# Wiki-page Structurer (build_wiki.py) + health-check contradiction detection
GRAPH_COMPILER_MODEL=claude-sonnet-5
# Per-SKU narrative enrichment (compile/compiler.py, --llm-enrich) — thousands
# of small, cheap calls, so this stays on a cheaper tier than the two above.
GRAPH_SKU_ENRICH_MODEL=claude-haiku-4-5

# Paths (defaults are fine for local dev)
GRAPH_DATA_DIR=./data
GRAPH_WIKI_DIR=./data/wiki
GRAPH_DUCKDB_PATH=./data/staging.duckdb
GRAPH_AUDIT_DB_PATH=./data/audit.sqlite

# API
GRAPH_API_HOST=127.0.0.1
GRAPH_API_PORT=8000
