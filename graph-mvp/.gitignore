.env
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Generated data — keep the directory layout, drop the contents
data/staging.duckdb
data/audit.sqlite
data/narrative_cache.sqlite
data/raw/*
!data/raw/.gitkeep
data/wiki/skus/*.md
data/wiki/suppliers/*.md
data/wiki/customers/*.md
data/wiki/warehouses/*.md
data/wiki/refrigerants/*.md
data/wiki/concepts/*.md

# Obsidian local state — ignore everything except the committed defaults
data/wiki/.obsidian/*
!data/wiki/.obsidian/graph.json
!data/wiki/.obsidian/app.json
!data/wiki/.obsidian/appearance.json
